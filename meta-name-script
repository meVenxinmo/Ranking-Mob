local function playClickEffect()
    local ring = Instance.new("Frame")
    ring.AnchorPoint = Vector2.new(0.5, 0.5)
    ring.Position = UDim2.fromScale(0.5, 0.5)
    ring.Size = UDim2.fromScale(0.85, 0.85)
    ring.BackgroundTransparency = 1
    ring.ZIndex = 0
    ring.Parent = toggle
    local ringCorner = Instance.new("UICorner")
    ringCorner.CornerRadius = UDim.new(0, 14)
    ringCorner.Parent = ring
    local ringStroke = Instance.new("UIStroke")
    ringStroke.Color = Color3.fromRGB(235, 235, 240)
    ringStroke.Thickness = 2
    ringStroke.Transparency = 0.15
    ringStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    ringStroke.Parent = ring

    local expand = TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    TweenService:Create(ring, expand, {Size = UDim2.fromScale(1.45, 1.45)}):Play()
    TweenService:Create(ringStroke, expand, {Transparency = 1, Thickness = 0.5}):Play()
    task.delay(0.5, function() ring:Destroy() end)

    local down = TweenService:Create(toggleScale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.88})
    down:Play()
    down.Completed:Connect(function()
        TweenService:Create(toggleScale, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1}):Play()
    end)
end

toggle.MouseButton1Click:Connect(function()
    playClickEffect()
    setOpen(not isOpen)
end)
close.MouseButton1Click:Connect(function() setOpen(false) end)
cardClose.MouseButton1Click:Connect(function() card.Visible = false end)

local stopped = false
task.spawn(function()
    while not stopped do
        task.wait(REFRESH_DELAY)
        if isOpen and dirty and not stopped then
            dirty = false
            pcall(refresh)
        end
    end
end)

env._LB_UNLOAD = function()
    if stopped then return end
    stopped = true
    for _, c in ipairs(globalConns) do
        if c.Connected then c:Disconnect() end
    end
    pcall(function() gui:Destroy() end)
    env._LB_UNLOAD = nil
end
