local function getThumb(userId)
    return "rbxthumb://type=AvatarBust&id=" .. userId .. "&w=420&h=420"
end

local function readStat(plr)
    local ls = plr:FindFirstChild("leaderstats")
    if not ls then return 0 end
    local v = ls:FindFirstChild(STAT_NAME)
    if not v then
        for _, child in ipairs(ls:GetChildren()) do
            if child:IsA("ValueBase") and typeof(child.Value) == "number" then
                v = child
                break
            end
        end
    end
    if v and typeof(v.Value) == "number" then return v.Value end
    return 0
end

