local function refresh()
    local entries = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if not rows[plr] then createRow(plr) end
        table.insert(entries, {plr = plr, value = readStat(plr)})
    end
    table.sort(entries, function(a, b) return a.value > b.value end)
    for i, entry in ipairs(entries) do
        local r = rows[entry.plr]
        r.row.LayoutOrder = i
        r.rank = i
        r.value = entry.value
        local text = formatNumber(entry.value)
        if r.val.Text ~= text then r.val.Text = text end
    end
    for plr, r in pairs(rows) do
        if not plr.Parent then
            r.row:Destroy()
            rows[plr] = nil
        end
    end
    if card.Visible and cardPlayer and rows[cardPlayer] then
        cardRank.Text = "Rank #" .. rows[cardPlayer].rank
        cardSize.Text = formatNumber(rows[cardPlayer].value)
    elseif card.Visible then
        card.Visible = false
    end
end

local function hookValue(inst)
    if inst:IsA("ValueBase") then
        inst.Changed:Connect(function() dirty = true end)
    end
end

local function hookStats(ls)
    for _, child in ipairs(ls:GetChildren()) do hookValue(child) end
    ls.ChildAdded:Connect(function(child)
        hookValue(child)
        dirty = true
    end)
end

local function watch(plr)
    local ls = plr:FindFirstChild("leaderstats")
    if ls then hookStats(ls) end
    plr.ChildAdded:Connect(function(child)
        if child.Name == "leaderstats" then
            hookStats(child)
            dirty = true
        end
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do watch(plr) end
globalConns[#globalConns + 1] = Players.PlayerAdded:Connect(function(plr)
    watch(plr)
    dirty = true
end)
globalConns[#globalConns + 1] = Players.PlayerRemoving:Connect(function(plr)
    local r = rows[plr]
    if r then
        r.row:Destroy()
        rows[plr] = nil
    end
    dirty = true
end)

local isOpen = false
local openPos = UDim2.new(1 - PANEL_RIGHT_MARGIN, 0, PANEL_TOP, 0)
local hiddenPos = UDim2.new(1 - PANEL_RIGHT_MARGIN, 0, -PANEL_HEIGHT - 0.1, 0)
local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local currentTween

local function setOpen(state)
    if isOpen == state then return end
    isOpen = state
    toggleIcon.Text = state and "-" or "+"
    if currentTween then currentTween:Cancel() end
    if state then
        card.Visible = false
        refresh()
        dirty = false
        panel.Visible = true
        currentTween = TweenService:Create(panel, tweenInfo, {Position = openPos})
        currentTween:Play()
    else
        card.Visible = false
        currentTween = TweenService:Create(panel, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = hiddenPos})
        currentTween:Play()
        currentTween.Completed:Connect(function()
            if not isOpen then panel.Visible = false end
        end)
    end
end

